# GestorAcademia — plantilla de variables de entorno.
#
# Copia este fichero a `.env.local` y rellena los valores. `.env.local` está en `.gitignore`
# y NO se commitea nunca. Este fichero (`.env.ejemplo`) sí se commitea, pero SIN valores.
#
# Regla que no se salta nadie (§0.2 de HOJA_DE_RUTA.md):
#   - La clave anónima (ANON_KEY) es pública por diseño: es la única que puede entrar en el
#     paquete del cliente.
#   - El access token, la contraseña de base de datos y la clave service_role viven solo aquí y
#     en los secretos del CI. Nunca en el repositorio, en el build, en un log ni en un documento.

# --- Management API (aplicar migraciones) ---------------------------------
# Personal Access Token. Se genera en Supabase: Account Settings -> Access Tokens.
# Lo usa exclusivamente el runner de migraciones (npm run migrate), nunca la aplicacion.
SUPABASE_ACCESS_TOKEN=

# --- Proyecto de DESARROLLO (el agente es autonomo aqui) ------------------
# El "project ref" es el identificador del proyecto: https://<ref>.supabase.co
# Si solo existe SUPABASE_PROJECT_REF (sin sufijo, sin _DEV ni _PROD), el runner lo trata como el
# de desarrollo.
SUPABASE_PROJECT_REF_DEV=
SUPABASE_URL_DEV=
SUPABASE_ANON_KEY_DEV=
# Solo para `npm run seed` (T-07): bypasea RLS para crear los usuarios y filas de ejemplo de las
# tablas que todavia no tienen ninguna politica (T-10). Nunca en el entorno de un agente.
SUPABASE_SERVICE_ROLE_KEY_DEV=

# --- Proyecto de PRODUCCION (el DDL lo aplica una persona) ----------------
# Pendiente de crear. Mientras esté vacío, el runner solo puede apuntar a desarrollo y las
# filas de "propagar a produccion" de §3 de SEGUIMIENTO.md quedan a la espera.
SUPABASE_PROJECT_REF_PROD=
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# --- Salvaguardas ---------------------------------------------------------
# El runner de migraciones solo acepta apuntar a produccion si se le pasa --entorno=prod
# Y ADEMAS esta variable vale 1. El agente no la activa nunca (§0.3).
PERMITIR_PROD=

# --- Configuracion del centro --------------------------------------------
ZONA_HORARIA_CENTRO=Europe/Madrid
